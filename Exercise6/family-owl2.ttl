@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix fam:  <http://www.ifi.uio.no/IN3060/family#> .

<http://www.ifi.uio.no/IN3060/family>
    rdf:type owl:Ontology .


# ============================================================
# Classes
# ============================================================

fam:Family
    rdf:type rdfs:Class .

fam:Man
    rdf:type rdfs:Class ;
    rdfs:subClassOf foaf:Person .

fam:Woman
    rdf:type rdfs:Class ;
    rdfs:subClassOf foaf:Person .

fam:Gender
    rdf:type rdfs:Class .


# ============================================================
# Gender values
# ============================================================

fam:Female
    rdf:type fam:Gender .

fam:Male
    rdf:type fam:Gender .


# ============================================================
# General family properties
# ============================================================

fam:hasFamilyMember
    rdf:type rdf:Property ;
    rdfs:domain fam:Family ;
    rdfs:range foaf:Person .

fam:hasGender
    rdf:type rdf:Property ;
    rdfs:domain foaf:Person ;
    rdfs:range fam:Gender .

fam:isRelativeOf
    rdf:type rdf:Property ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .


# ============================================================
# Sibling properties
# ============================================================

fam:hasSibling
    rdf:type rdf:Property ;
    rdfs:subPropertyOf fam:isRelativeOf ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

fam:hasBrother
    rdf:type rdf:Property ;
    rdfs:subPropertyOf fam:hasSibling ;
    rdfs:domain foaf:Person ;
    rdfs:range fam:Man .

fam:hasSister
    rdf:type rdf:Property ;
    rdfs:subPropertyOf fam:hasSibling ;
    rdfs:domain foaf:Person ;
    rdfs:range fam:Woman .


# ============================================================
# Parent properties
# ============================================================

fam:hasParent
    rdf:type rdf:Property ;
    rdfs:subPropertyOf fam:isRelativeOf ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

fam:hasMother
    rdf:type rdf:Property ;
    rdfs:subPropertyOf fam:hasParent ;
    rdfs:domain foaf:Person ;
    rdfs:range fam:Woman .

fam:hasFather
    rdf:type rdf:Property ;
    rdfs:subPropertyOf fam:hasParent ;
    rdfs:domain foaf:Person ;
    rdfs:range fam:Man .


# ============================================================
# Spouse property
# ============================================================

fam:hasSpouse
    rdf:type rdf:Property ;
    rdfs:subPropertyOf fam:isRelativeOf ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .
    
